# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Concurrency and polling
WORKER_CONCURRENCY=1
POLL_INTERVAL_MS=2000
JOB_TIMEOUT_SECONDS=300
LEASE_SECONDS=360
PORT=8080

# Optional overrides (safe defaults exist for all of these)
# RENDER_BLEND_ENGINE_VERSION=render-blend-v1
# MAX_SOURCE_BYTES=262144000
# MAX_OUTPUT_SECONDS=900
# MAX_ATTEMPTS=3
# HEARTBEAT_INTERVAL_MS=20000
# BLENDS_BUCKET=blends
# TEMP_DIR=/tmp
